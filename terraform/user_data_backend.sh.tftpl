#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y awscli curl java-17-amazon-corretto-headless tar

groupadd --system wildfly || true
id wildfly >/dev/null 2>&1 || useradd --system --gid wildfly --home-dir /opt/wildfly --shell /sbin/nologin wildfly

WILDFLY_VERSION="${wildfly_version}"
WILDFLY_HOME="/opt/wildfly"
POSTGRES_DRIVER_VERSION="${postgres_driver_version}"
POSTGRES_DRIVER_JAR="postgresql-$${POSTGRES_DRIVER_VERSION}.jar"
DEPLOYMENTS_DIR="$${WILDFLY_HOME}/standalone/deployments"

curl -fsSL "https://github.com/wildfly/wildfly/releases/download/$${WILDFLY_VERSION}/wildfly-$${WILDFLY_VERSION}.tar.gz" -o /tmp/wildfly.tar.gz
rm -rf "$${WILDFLY_HOME}"
mkdir -p "$${WILDFLY_HOME}"
tar -xzf /tmp/wildfly.tar.gz --strip-components=1 -C "$${WILDFLY_HOME}"
chown -R wildfly:wildfly "$${WILDFLY_HOME}"

"$${WILDFLY_HOME}/bin/add-user.sh" admin "${wildfly_admin_password}" --silent

curl -fsSL "https://jdbc.postgresql.org/download/$${POSTGRES_DRIVER_JAR}" -o "$${WILDFLY_HOME}/bin/$${POSTGRES_DRIVER_JAR}"
chown wildfly:wildfly "$${WILDFLY_HOME}/bin/$${POSTGRES_DRIVER_JAR}"

cat >/etc/research-center.env <<'EOF'
DATASOURCE_JNDI=${datasource_jndi}
DATASOURCE_NAME=${datasource_name}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_username}
DB_PASS=${db_password}
POSTGRES_DRIVER_VERSION=${postgres_driver_version}
EOF
chmod 0600 /etc/research-center.env
chown root:wildfly /etc/research-center.env

cat >/etc/systemd/system/wildfly.service <<'EOF'
[Unit]
Description=WildFly Application Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wildfly
Group=wildfly
Environment=WILDFLY_HOME=/opt/wildfly
EnvironmentFile=/etc/research-center.env
ExecStart=/opt/wildfly/bin/standalone.sh -b=0.0.0.0 -bmanagement=127.0.0.1 -c standalone.xml
ExecStop=/opt/wildfly/bin/jboss-cli.sh --connect --commands=:shutdown
Restart=on-failure
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
EOF

function wait_for_wildfly() {
  until "$${WILDFLY_HOME}/bin/jboss-cli.sh" --connect --commands=":read-attribute(name=server-state)" >/dev/null 2>&1; do
    sleep 2
  done
}

sudo -u wildfly "$${WILDFLY_HOME}/bin/standalone.sh" -b=127.0.0.1 -bmanagement=127.0.0.1 -c standalone.xml >/var/log/wildfly-bootstrap.log 2>&1 &
WILDFLY_BOOTSTRAP_PID="$!"
wait_for_wildfly

"$${WILDFLY_HOME}/bin/jboss-cli.sh" --connect <<EOF
batch
module add --name=org.postgresql --resources=$${WILDFLY_HOME}/bin/$${POSTGRES_DRIVER_JAR}
/subsystem=datasources/jdbc-driver=postgres:add(driver-name=postgres,driver-module-name=org.postgresql,driver-class-name=org.postgresql.Driver)
data-source add --jndi-name=${datasource_jndi} --name=${datasource_name} --connection-url=jdbc:postgresql://${db_host}:${db_port}/${db_name} --driver-name=postgres --user-name=${db_username} --password=${db_password} --check-valid-connection-sql="SELECT 1" --background-validation=true --background-validation-millis=60000 --flush-strategy=IdleConnections --min-pool-size=5 --max-pool-size=50 --pool-prefill=false
run-batch
:shutdown
EOF

wait "$${WILDFLY_BOOTSTRAP_PID}" || true

%{ if backend_artifact_bucket != "" && backend_artifact_key != "" ~}
aws s3 cp "s3://${backend_artifact_bucket}/${backend_artifact_key}" "$${DEPLOYMENTS_DIR}/${app_name}.war"
chown wildfly:wildfly "$${DEPLOYMENTS_DIR}/${app_name}.war"
%{ else ~}
cat >"$${DEPLOYMENTS_DIR}/README.deploy" <<'EOF'
Upload ${app_name}.war to this directory or set backend_artifact_bucket/backend_artifact_key before provisioning.
EOF
chown wildfly:wildfly "$${DEPLOYMENTS_DIR}/README.deploy"
%{ endif ~}

systemctl daemon-reload
systemctl enable --now wildfly
